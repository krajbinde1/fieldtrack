APP_NAME="Param FieldTrack"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://fieldtrack.paramgold.in

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Independent FieldTrack MySQL database. Never point this at ParamGold ERP.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Local development only:
# APP_ENV=local
# APP_DEBUG=true
# APP_URL=http://127.0.0.1:8000
# DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=fieldtrack.paramgold.in
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@fieldtrack.paramgold.in"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=fieldtrack.paramgold.in

VITE_APP_NAME="${APP_NAME}"

# Fallback for GET /api/app-version until Admin saves App Update Settings.
MOBILE_APP_LATEST_VERSION=1.0.4
MOBILE_APP_LATEST_BUILD=5
MOBILE_APP_APK_URL=https://fieldtrack.paramsocialfoundation.org/apk/paramfieldtrack-latest.apk
MOBILE_APP_FORCE_UPDATE=false
